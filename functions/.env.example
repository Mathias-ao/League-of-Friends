# Optional: comma-separated additional web origins allowed to start Steam OpenID.
# Firebase Hosting defaults for the current project and localhost:5173 are allowed automatically.
# Example:
# STEAM_AUTH_ALLOWED_ORIGINS=https://aof.example.com,https://www.aof.example.com
STEAM_AUTH_ALLOWED_ORIGINS=

# Optional server-only Steam Web API key for verified profile names/avatars.
# Without a key, a bounded Community XML lookup is used; outages leave names pending.
# Never set this in a VITE_ variable or commit a real value.
STEAM_WEB_API_KEY=
