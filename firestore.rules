rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authLinkPath() {
      return /databases/$(database)/documents/authLinks/$(request.auth.uid);
    }

    function hasAuthLink() {
      return signedIn() && exists(authLinkPath());
    }

    function currentPlayerId() {
      return get(authLinkPath()).data.playerId;
    }

    function currentPlayerPath() {
      return /databases/$(database)/documents/players/$(currentPlayerId());
    }

    function isActiveMember() {
      return hasAuthLink()
        && exists(currentPlayerPath())
        && get(currentPlayerPath()).data.membershipStatus == 'ACTIVE';
    }

    function isAdmin() {
      return isActiveMember()
        && get(currentPlayerPath()).data.role == 'ADMIN';
    }

    // Authentication mappings are private implementation data.
    match /authLinks/{uid} {
      allow read, write: if false;
    }

    // The player website uses authenticated callable read models.
    match /players/{playerId} {
      allow read: if isActiveMember() && currentPlayerId() == playerId;
      allow write: if false;
    }
    match /players/{playerId}/{document=**} {
      allow read: if isActiveMember() && currentPlayerId() == playerId;
      allow write: if false;
    }
    // Rules combine with OR; explicitly exclude authLinks from this grant.
    match /{collectionName}/{document=**} {
      allow read: if collectionName != 'authLinks' && isAdmin();
      allow write: if false;
    }
  }
}
