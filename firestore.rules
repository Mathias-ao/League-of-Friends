rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authLinkPath() {
      return /databases/$(database)/documents/authLinks/$(request.auth.uid);
    }

    function hasAuthLink() {
      return signedIn() && exists(authLinkPath());
    }

    function currentPlayerId() {
      return get(authLinkPath()).data.playerId;
    }

    function currentPlayerPath() {
      return /databases/$(database)/documents/players/$(currentPlayerId());
    }

    function isActiveMember() {
      return hasAuthLink()
        && exists(currentPlayerPath())
        && get(currentPlayerPath()).data.membershipStatus == 'ACTIVE';
    }

    function isAdmin() {
      return isActiveMember()
        && get(currentPlayerPath()).data.role == 'ADMIN';
    }

    // Authentication mappings are private implementation data.
    match /authLinks/{uid} {
      allow read, write: if false;
    }

    // League-facing data is readable to authenticated active members.
    // Authoritative writes are intentionally server-only in Version 1.
    match /{document=**} {
      allow read: if isActiveMember();
      allow write: if false;
    }
  }
}
