# Copy to web/.env.staging.local (private and never committed).
# Use ONLY the separately approved staging Firebase web-app configuration.
# Verify with: node scripts/verify-staging-web-env.mjs web/.env.staging.local
# Build with: npm run build --prefix web -- --mode staging
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=age-of-friends-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=age-of-friends-staging
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=europe-west1
VITE_USE_EMULATORS=false
# Separately authorized staging-only browser E2E opt-in (default off).
VITE_AOF_STAGING_E2E=false
# Same reviewed 40-char Git SHA as backend AOF_DEPLOY_GIT_SHA.
VITE_AOF_COMMIT_SHA=
