    "sourceMeasurementsRevision",
    "projectionRevision",
    "mode",
    "candidateEpisodeGroups",
    "neutralPlacementContexts",
    "neutralTributeRequestContexts",
    "officialWrites",
    "publicationAllowed",
    "claims",
    "actorWitnesses",
    "receipts",
    "trackCredits",
    "significanceBands",
    "limitations"
