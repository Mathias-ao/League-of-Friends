        "battleId": {
          "type": "string",
          "minLength": 1
        },
        "gameId": {
          "type": "string",
          "minLength": 1
        },
        "gameGuid": {
          "type": "string",
          "minLength": 1
        },
        "authorityRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gameScopeAuthenticated": {
      "const": false
    },
    "sourceRevision": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "null"
        ]
      }
    },
    "sourceContextRevision": {
      "type": "string",
      "minLength": 1
    },
    "sourceMeasurementsRevision": {
      "type": "string",
      "minLength": 1
    },
    "projectionRevision": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
