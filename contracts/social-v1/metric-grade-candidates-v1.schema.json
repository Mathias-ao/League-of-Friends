    "publicationAllowed": {
      "const": false
    },
    "claims": {
      "type": "array",
      "maxItems": 0
    },
    "actorWitnesses": {
      "type": "array",
      "maxItems": 0
    },
    "receipts": {
      "type": "array",
      "maxItems": 0
    },
    "trackCredits": {
      "type": "array",
      "maxItems": 0
    },
    "significanceBands": {
      "type": "array",
