{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mathias-ao/League-of-Friends/contracts/social-v1/metric-grade-candidates-v1.schema.json",
  "title": "AOF_SOCIAL_METRIC_GRADE_CANDIDATES_1 — PRIVATE PROPOSED INERT",
