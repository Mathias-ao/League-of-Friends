          "actorReplayPlayerId": {
            "type": "integer",
            "minimum": 1
          },
          "counterpartReplayPlayerId": {
            "type": "integer",
            "minimum": 1
          },
          "requestAmountStatus": {
            "enum": [
              "ZERO",
              "NONZERO",
              "UNKNOWN"
            ]
          },
          "decodedRequestAmount": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "sourceMeaning": {
            "const": "TRIBUTE_REQUEST_NOT_DELIVERED_BENEFIT"
