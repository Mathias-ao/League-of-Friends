            "properties": {
              "decision": {
                "const": "PENDING"
              },
              "bandId": {
                "type": "null"
              },
              "ruleVersion": {
                "type": "null"
              },
              "units": {
                "type": "null"
              },
              "historicalEffect": {
                "type": "null"
              }
            }
          },
          "coverage": {
            "const": "LIMITED"
