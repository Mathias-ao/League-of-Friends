            "type": "object",
            "additionalProperties": false,
            "required": [
              "recordingAtMs",
              "operationOrdinal"
            ],
            "properties": {
              "recordingAtMs": {
                "type": "integer",
                "minimum": 0
              },
              "operationOrdinal": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
