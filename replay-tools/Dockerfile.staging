# Staging-reviewable native replay worker image. Build from replay-tools/
# only: docker build -f Dockerfile.staging -t aof-native-worker:test .
# No secret, flag or user account is baked into the image.
FROM python:3.12-slim-bookworm
WORKDIR /app
COPY requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY . /app/
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AOF_REPLAY_WORKER_BIND=0.0.0.0 \
    PORT=8080
EXPOSE 8080
# Arbitrary unprivileged runtime UID; original recordings stay in ephemeral /tmp.
USER 10001:10001
CMD ["python", "upload_worker.py"]
